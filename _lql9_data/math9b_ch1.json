  {
   "t": "锐角三角函数定义",
   "d": "在Rt△ABC中，∠C=90°：sinA=对边/斜边，cosA=邻边/斜边，tanA=对边/邻边，三者都是两边之比，是数值（无单位）。"
  },
  {
   "t": "比值只与角度有关",
   "d": "锐角A的大小一定，sinA、cosA、tanA的值就确定，与直角三角形大小无关；锐角内，sin、tan随A增大而增大，cos随A增大而减小。"
  },
  {
   "t": "30°角的三角函数值",
   "d": "sin30°=1/2，cos30°=√3/2，tan30°=√3/3（即1/√3）。"
  },
  {
   "t": "45°角的三角函数值",
   "d": "sin45°=cos45°=√2/2，tan45°=1。"
  },
  {
   "t": "60°角的三角函数值",
   "d": "sin60°=√3/2，cos60°=1/2，tan60°=√3。"
  },
  {
   "t": "解直角三角形",
   "d": "由Rt△中除直角外的已知元素求其余未知元素。依据：两锐角互余、勾股定理、选恰当三角函数；至少要已知一条边。"
  },
  {
   "t": "平方关系",
   "d": "sin²A+cos²A=1 对任意锐角A成立。例：sinA=3/5，则cosA=√(1−9/25)=4/5（锐角取正号）。"
  },
  {
   "t": "互余角的函数关系",
   "d": "∠A+∠B=90°时，sinA=cosB、cosA=sinB，即sinA=cos(90°−A)；tanA·tanB=1。"
  },
  {
   "t": "仰角与俯角",
   "d": "视线在水平线上方时与水平线所成的角叫仰角，在下方时叫俯角。测高：高度=水平距离×tan(仰角)。"
  },
  {
   "t": "坡度与坡角",
   "d": "坡度i=铅直高度h/水平宽度l=tanα（α为坡角）。例：i=1:√3时，tanα=1/√3，坡角α=30°。"
  }
 ],
